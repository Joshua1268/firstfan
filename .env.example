# Copier en `.env` à la racine (ignoré par git). Lu par docker-compose.yml et le Makefile.
# Les variables de Django sont dans backend/.env (modèle : backend/.env.example).

# dev : runserver et pnpm dev, DEBUG vrai. prod (serveur) : gunicorn et serveur Next autonome, DEBUG faux.
ENV=dev
# Réseau Docker externe partagé avec le nginx du serveur (`docker network ls`). make up le crée s'il manque.
PROXY_NETWORK=web_network

# Ports publiés sur 127.0.0.1 seulement : Django sur 8010 et Next sur 3000 (make e2e les utilise).
# Sur le serveur, nginx passe par le réseau ci-dessus : changer ces ports seulement s'ils sont déjà pris.
BACKEND_PORT=8010
FRONTEND_PORT=3000

# Adresse affichée sur la page Contact (intégrée au build du front en prod).
NEXT_PUBLIC_CONTACT_EMAIL=
