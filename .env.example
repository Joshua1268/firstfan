# Copy to .env. Dev values; prod values in comments.

# Compose
# dev or prod
ENV=dev
PROXY_NETWORK=web_network
BACKEND_PORT=8010
FRONTEND_PORT=3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Database (prod: Systalink values)
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_NAME=cadev
DATABASE_USER=cadev
DATABASE_PASSWORD=cadev
DATABASE_SSL=false
# DATABASE_SSL_ROOT_CERT=/app/deploy/db-ca.pem
# Prod: 60
CONN_MAX_AGE=0

# Django
# Prod: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Prod: firstfan.jk-labs.tech,firstfan-backend
ALLOWED_HOSTS=*
# Prod: https://firstfan.jk-labs.tech
CSRF_TRUSTED_ORIGINS=
# Prod: https://firstfan.jk-labs.tech
SITE_URL=http://localhost:3000
NUM_PROXIES=1
DEMO_MODE=true
# Empty: make seed generates one
DEMO_PASSWORD=

PRODUCT_NAME=FirstFan
PRICE_PER_TESTER_XOF=5000
TESTER_REWARD_XOF=3500
PAYMENT_PROVIDER=simule
GUNICORN_WORKERS=2

# Google sign-in (empty: button hidden)
# Redirect URI: SITE_URL/api/auth/google/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Tester ranking (no key: by rating)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MATCHING_TIMEOUT_S=8
