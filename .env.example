# Production : copier en `.env` à la racine (ignoré par git) sur le serveur, puis remplir les secrets.
# Lu par le profil prod de docker-compose.yml (make prod-up) ; le développement local ne s'en sert pas.
# Mots de passe : lettres, chiffres, - et _ seulement.

# Domaine relayé par le nginx du serveur (enregistrement DNS A vers l'IP du serveur).
DOMAIN=firstfan.jk-labs.tech
# Réseau Docker externe du conteneur nginx : son nom est donné par `docker network ls`.
PROXY_NETWORK=web_network

# --- Base de données PostgreSQL gérée (Datacloud) ---
# Valeurs données par le panneau Datacloud.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=firstfan
DATABASE_USER=firstfan
DATABASE_PASSWORD=
# Passer à true si le fournisseur propose TLS : connexion chiffrée et certificat du serveur vérifié.
DATABASE_SSL=false
# Si le fournisseur donne son propre certificat d'autorité : le copier dans deploy/db-ca.pem (ignoré par git).
# DATABASE_SSL_ROOT_CERT=/app/deploy/db-ca.pem
# Secondes de réutilisation d'une connexion : évite les allers-retours réseau à chaque requête.
CONN_MAX_AGE=60

# --- Django ---
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# « firstfan-backend » : le rendu serveur de Next appelle Django avec cet hôte.
ALLOWED_HOSTS=${DOMAIN},firstfan-backend
CSRF_TRUSTED_ORIGINS=https://${DOMAIN}
SITE_URL=https://${DOMAIN}
# nginx est le seul proxy devant Django.
NUM_PROXIES=1
# true pour la démo du jury ; false en production réelle, après avoir purgé les comptes demo-testeur-NN.
DEMO_MODE=true
# Mot de passe du compte dev de démo. Vide : généré et affiché une fois par seed_demo.
DEMO_PASSWORD=

PRODUCT_NAME=FirstFan
# Montants en FCFA (XOF, entiers).
PRICE_PER_TESTER_XOF=5000
TESTER_REWARD_XOF=3500
PAYMENT_PROVIDER=simule
# Gunicorn : 2 workers pour 1 vCPU et 2 Go de RAM.
GUNICORN_WORKERS=2

# Recommandation de testeurs : Groq, puis Mistral (offres gratuites). Vides : classement par règles.
GROQ_API_KEY=
MISTRAL_API_KEY=

# --- Frontend ---
# Adresse affichée sur la page Contact.
NEXT_PUBLIC_CONTACT_EMAIL=
