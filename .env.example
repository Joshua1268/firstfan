# Variables d'environnement de FirstFan. Copier en `.env` (ignoré par git) et adapter.
# En développement, aucune n'est obligatoire : les valeurs par défaut suffisent.

# --- Backend Django ---
# Lu par le service backend de docker-compose.yml, qui force DATABASE_HOST=db et DATABASE_PORT=5432.
# Les valeurs ci-dessous servent quand Django tourne sur l'hôte.
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_NAME=cadev
DATABASE_USER=cadev
DATABASE_PASSWORD=cadev

# Développement : DEBUG vrai, clé de dev, tous les hôtes, mode démo actif.
DEBUG=true

# Production (DEBUG=false) : Django refuse de démarrer si l'une de ces valeurs manque.
# - SECRET_KEY : longue et aléatoire, jamais la clé de dev
#   (python -c "import secrets; print(secrets.token_urlsafe(50))")
# - ALLOWED_HOSTS : domaines servis, séparés par des virgules, sans « * »
# - CSRF_TRUSTED_ORIGINS : origines https du site, séparées par des virgules
# - DEMO_MODE : à définir explicitement (true pour la démo du jury, false en production réelle ;
#   dans ce cas, purger d'abord les comptes demo-testeur-NN)
# SECRET_KEY=
# ALLOWED_HOSTS=nom.example
# CSRF_TRUSTED_ORIGINS=https://nom.example
DEMO_MODE=true
# Mot de passe du compte dev de démo (demo-dev@firstfan.demo). Vide : généré et affiché une fois par make seed.
# DEMO_PASSWORD=

# Optionnels en production (nginx termine le TLS devant Django) :
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_SSL_REDIRECT=false
# NUM_PROXIES=1
# Limites de débit DRF :
# THROTTLE_ANON=60/min
# THROTTLE_USER=300/min
# THROTTLE_PUBLIC_STATS=240/min

PRODUCT_NAME=FirstFan
# Adresse publique du site, reprise dans le script de suivi donné aux devs.
SITE_URL=http://localhost:3000
# Montants en FCFA (XOF, entiers) : prix payé par testeur et gain versé au testeur.
PRICE_PER_TESTER_XOF=5000
TESTER_REWARD_XOF=3500
# Fournisseur de paiement : seul « simule » existe (aucun argent ne circule).
PAYMENT_PROVIDER=simule
# Recommandation de testeurs : Groq, puis Mistral (offres gratuites). Sans clé, classement par note.
# Les clés se mettent dans backend/.env (ignoré par git), lu aussi par le service backend.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MATCHING_TIMEOUT_S=8

# --- Frontend Next.js ---
# URL de Django vue par le serveur Next (réécriture /api/* et rendu des compteurs).
# Le service frontend de docker-compose.yml force http://backend:8010 ; cette valeur sert quand Next tourne sur l'hôte.
API_INTERNAL_URL=http://127.0.0.1:8010
# Adresse affichée sur la page Contact (laisser vide tant que le domaine n'est pas choisi).
NEXT_PUBLIC_CONTACT_EMAIL=
