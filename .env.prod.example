# Production : copier en `.env` à la racine (ignoré par git) sur le serveur, puis remplir les secrets.
# Lu par docker-compose.prod.yml. Mots de passe : lettres, chiffres, - et _ seulement.

# Domaine servi par Caddy (enregistrement DNS A vers l'IP du serveur).
DOMAIN=firstfan.jk-labs.tech

# --- PostgreSQL ---
POSTGRES_DB=firstfan
POSTGRES_USER=firstfan
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Django ---
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# « backend » : le rendu serveur de Next appelle Django avec cet hôte.
ALLOWED_HOSTS=${DOMAIN},backend
CSRF_TRUSTED_ORIGINS=https://${DOMAIN}
SITE_URL=https://${DOMAIN}
# Caddy est le seul proxy devant Django.
NUM_PROXIES=1
# true pour la démo du jury ; false en production réelle, après avoir purgé les comptes demo-testeur-NN.
DEMO_MODE=true
# Mot de passe du compte dev de démo. Vide : généré et affiché une fois par seed_demo.
DEMO_PASSWORD=

PRODUCT_NAME=FirstFan
# Montants en FCFA (XOF, entiers).
PRICE_PER_TESTER_XOF=5000
TESTER_REWARD_XOF=3500
PAYMENT_PROVIDER=simule
# Gunicorn : 2 workers pour 1 vCPU et 2 Go de RAM.
GUNICORN_WORKERS=2

# Recommandation de testeurs : Groq, puis Mistral (offres gratuites). Vides : classement par règles.
GROQ_API_KEY=
MISTRAL_API_KEY=

# --- Frontend ---
# Adresse affichée sur la page Contact.
NEXT_PUBLIC_CONTACT_EMAIL=
