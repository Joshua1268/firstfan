# Copier en `backend/.env` (ignoré par git), obligatoire. Lu par le service firstfan-backend.
# Valeurs de dev par défaut ; la valeur de prod est indiquée en commentaire quand elle diffère.
# DEBUG suit ENV (fichier .env racine) : vrai en dev, faux en prod.
# Mots de passe : lettres, chiffres, - et _ seulement.

# --- Base de données PostgreSQL ---
# Dev : PostgreSQL 16 installé sur le Mac (brew), joint depuis Docker par host.docker.internal.
# Prod : valeurs du panneau Systalink.
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
# Prod : firstfan
DATABASE_NAME=cadev
# Prod : firstfan
DATABASE_USER=cadev
# Prod : mot de passe donné par Systalink
DATABASE_PASSWORD=cadev
# true si le fournisseur propose TLS : connexion chiffrée et certificat du serveur vérifié. Prod Systalink : false.
DATABASE_SSL=false
# Si le fournisseur donne son propre certificat d'autorité : le copier dans deploy/db-ca.pem (ignoré par git).
# DATABASE_SSL_ROOT_CERT=/app/deploy/db-ca.pem
# Secondes de réutilisation d'une connexion à une base distante. Prod : 60
CONN_MAX_AGE=0

# --- Django ---
# Absente en dev : clé de développement. Prod : décommenter et remplir avec
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=
# Prod : firstfan.jk-labs.tech,firstfan-backend (le rendu serveur de Next appelle Django avec ce second hôte).
ALLOWED_HOSTS=*
# Absente en dev : origines locales de Next. Prod : décommenter.
# CSRF_TRUSTED_ORIGINS=https://firstfan.jk-labs.tech
# Adresse publique du site, reprise dans le script de suivi donné aux devs. Prod : https://firstfan.jk-labs.tech
SITE_URL=http://localhost:3000
# Proxys devant Django (ignoré en dev). Prod : 1, nginx seul.
NUM_PROXIES=1
# true pour la démo du jury ; false en production réelle, après avoir purgé les comptes demo-testeur-NN.
DEMO_MODE=true
# Mot de passe du compte dev de démo (demo-dev@firstfan.demo). Vide : généré et affiché une fois par make seed.
DEMO_PASSWORD=

PRODUCT_NAME=FirstFan
# Montants en FCFA (XOF, entiers).
PRICE_PER_TESTER_XOF=5000
TESTER_REWARD_XOF=3500
PAYMENT_PROVIDER=simule
# Gunicorn (prod seulement) : 2 workers pour 1 vCPU et 2 Go de RAM.
GUNICORN_WORKERS=2

# --- Recommandation de testeurs ---
# Groq, puis Mistral (offres gratuites). Sans clé, classement par note.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# Délai maximal d'une réponse de l'IA, en secondes.
# MATCHING_TIMEOUT_S=8
