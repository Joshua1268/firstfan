# Développement local : copier en `backend/.env` (ignoré par git) si besoin.
# Lu par le service backend du profil dev de docker-compose.yml (make up), qui fixe déjà
# DEBUG, la base locale et des limites de débit relevées pour les tests e2e.
# Aucune valeur n'est obligatoire : sans ce fichier, les valeurs par défaut suffisent.

# Recommandation de testeurs : Groq, puis Mistral (offres gratuites). Sans clé, classement par note.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# Délai maximal d'une réponse de l'IA, en secondes.
# MATCHING_TIMEOUT_S=8

# Mot de passe du compte dev de démo (demo-dev@firstfan.demo). Vide : généré et affiché une fois par make seed.
# DEMO_PASSWORD=

# Adresse publique du site, reprise dans le script de suivi donné aux devs.
# SITE_URL=http://localhost:3000
